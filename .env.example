# Copy to .env and fill in what you need. Every variable is optional.

# --- AI copy analysis (Phase 3). Leave blank to disable AI features. ---
ANTHROPIC_API_KEY=
# Override the model from config/settings.yaml
ANTHROPIC_MODEL=

# --- Telegram alerts (Phase 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email alerts via SMTP (Phase 4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true

# --- Paths / server ---
# Where the database, media, reports and logs live (default: ./data)
ADSPY_DATA_DIR=
ADSPY_HOST=127.0.0.1
ADSPY_PORT=8000
# Path to a specific Chrome binary (default: auto-detected by Selenium Manager)
CHROME_BINARY=
