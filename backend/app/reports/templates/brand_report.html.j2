{%- macro bars(items, total=None, label_key="name", value_key="count", limit=8) -%}
{%- set peak = (items | map(attribute=value_key) | max) if items else 0 -%}
<div class="bars">
  {% for it in items[:limit] %}
  <div class="bar">
    <span class="bl">{{ it[label_key] | label }}</span>
    <span class="track"><span class="fill" style="width: {{ (100 * it[value_key] / peak) | round(1) if peak else 0 }}%"></span></span>
    <span class="bv">{% if it.share is defined %}{{ it.share }}%{% else %}{{ it[value_key] }}{% endif %}</span>
  </div>
  {% endfor %}
</div>
{%- endmacro -%}
{%- macro pairs(items, limit=8) -%}
{%- set peak = (items | map(attribute=1) | max) if items else 0 -%}
<div class="bars">
  {% for name, n in items[:limit] %}
  <div class="bar">
    <span class="bl">{{ name | label }}</span>
    <span class="track"><span class="fill" style="width: {{ (100 * n / peak) | round(1) if peak else 0 }}%"></span></span>
    <span class="bv">{{ n }}</span>
  </div>
  {% endfor %}
</div>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · Competitor Ad Report</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --primary: {{ brand.primary }};
    --accent: {{ brand.accent }};
    --ink: #15151F; --muted: #5E5E73; --faint: #8C8CA1; --line: #E5E5EE; --panel: #F6F6FA; --track: #ECECF3;
    --win: #B45309; --win-bg: #FEF3C7; --prom: #047857; --prom-bg: #D1FAE5; --test: #1D4ED8; --test-bg: #DBEAFE;
  }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; color: var(--ink); font: 10pt/1.5 Inter, system-ui, sans-serif; background: #fff; }
  .num { font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }

  @page { size: A4; margin: 16mm 14mm 17mm;
    @bottom-left { content: "{{ footer }}"; font: 7.5pt Inter, sans-serif; color: #8C8CA1; }
    @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 7.5pt Inter, sans-serif; color: #8C8CA1; } }
  @page cover { margin: 0; @bottom-left { content: none; } @bottom-right { content: none; } }

  /* ---------- cover ---------- */
  .cover { page: cover; position: relative; height: 297mm; width: 210mm; overflow: hidden; color: #fff;
    background: radial-gradient(130mm 110mm at 8% 0%, color-mix(in srgb, var(--primary) 85%, transparent), transparent 70%),
                radial-gradient(120mm 90mm at 100% 100%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%), #0B0B12;
    padding: 22mm 20mm; display: flex; flex-direction: column; }
  .cover .top { display: flex; align-items: center; gap: 12px; }
  .cover .top img { height: 13mm; max-width: 60mm; object-fit: contain; }
  .cover .agency { font-weight: 700; font-size: 12pt; letter-spacing: -.01em; }
  .cover .mid { margin-top: auto; }
  .cover .eyebrow { text-transform: uppercase; letter-spacing: .18em; font-size: 8.5pt; font-weight: 600; color: color-mix(in srgb, #fff 70%, transparent); }
  .cover h1 { font-size: 36pt; line-height: 1.05; letter-spacing: -.03em; margin: 5mm 0 4mm; font-weight: 800; }
  .cover .for { font-size: 13pt; color: color-mix(in srgb, #fff 80%, transparent); }
  .cover .for b { color: #fff; }
  .cover .rule { width: 22mm; height: 1.2mm; border-radius: 1mm; background: var(--accent); margin: 9mm 0; }
  .cover .brands { display: flex; flex-wrap: wrap; gap: 4mm; }
  .cover .chip { display: flex; align-items: center; gap: 3mm; padding: 2.5mm 4mm 2.5mm 2.5mm; border-radius: 3mm;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); }
  .cover .chip img, .cover .chip .ph { width: 9mm; height: 9mm; border-radius: 2mm; object-fit: cover; background: rgba(255,255,255,.15); display: grid; place-items: center; font-weight: 700; }
  .cover .chip small { display: block; color: rgba(255,255,255,.65); font-size: 7.5pt; }
  .cover .bottom { margin-top: 14mm; display: flex; justify-content: space-between; align-items: flex-end; font-size: 8pt; color: rgba(255,255,255,.6); }

  /* ---------- body ---------- */
  .section { break-before: page; }
  .section.flow { break-before: auto; margin-top: 9mm; }
  .no-cover .section:first-of-type { break-before: auto; }
  .eyebrow { text-transform: uppercase; letter-spacing: .14em; font-size: 7.5pt; font-weight: 700; color: var(--primary); }
  h2 { font-size: 19pt; letter-spacing: -.02em; margin: 1.5mm 0 1.5mm; line-height: 1.15; }
  .lede { color: var(--muted); margin: 0 0 6mm; max-width: 150mm; }
  h3 { font-size: 10.5pt; margin: 0 0 3mm; }
  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3mm; margin: 0 0 7mm; }
  .kpi { border: 1px solid var(--line); border-radius: 3mm; padding: 3.5mm 4mm; background: var(--panel); }
  .kpi .n { font: 600 17pt 'JetBrains Mono', monospace; letter-spacing: -.02em; }
  .kpi .l { color: var(--muted); font-size: 8pt; }
  .kpi.hl { background: color-mix(in srgb, var(--primary) 7%, #fff); border-color: color-mix(in srgb, var(--primary) 25%, #fff); }
  .kpi.hl .n { color: var(--primary); }
  .points { margin: 0; padding: 0; list-style: none; display: grid; gap: 2.5mm; }
  .points li { position: relative; padding-left: 6mm; }
  .points li::before { content: ""; position: absolute; left: 0; top: 2mm; width: 2.2mm; height: 2.2mm; border-radius: 50%; background: var(--primary); }
  .ai-note { margin: 0 0 5mm; padding: 4mm 5mm; border-radius: 3mm; border-left: 1mm solid var(--primary); background: var(--panel); }
  .ai-tag { display: inline-block; font-size: 7pt; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--primary); margin-bottom: 1mm; }

  table { width: 100%; border-collapse: collapse; font-size: 8.5pt; }
  th, td { text-align: left; padding: 2.2mm 2.5mm; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: 7.5pt; text-transform: uppercase; letter-spacing: .06em; }
  td.r, th.r { text-align: right; }
  tr { break-inside: avoid; }
  .brandcell { display: flex; align-items: center; gap: 2.5mm; font-weight: 600; }
  .brandcell img, .brandcell .ph { width: 6mm; height: 6mm; border-radius: 1.5mm; object-fit: cover; background: var(--track); display: grid; place-items: center; font-size: 7pt; }

  .bars { display: grid; gap: 2mm; }
  .bar { display: grid; grid-template-columns: 32mm 1fr 13mm; gap: 3mm; align-items: center; font-size: 8.5pt; }
  .bar .bl { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar .track { height: 2.4mm; border-radius: 2mm; background: var(--track); overflow: hidden; display: block; }
  .bar .fill { display: block; height: 100%; border-radius: 2mm; background: var(--primary); }
  .bar .bv { text-align: right; font-family: 'JetBrains Mono', monospace; color: var(--muted); font-size: 8pt; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 5mm; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4mm; }
  .panel { border: 1px solid var(--line); border-radius: 3mm; padding: 4mm 4.5mm; break-inside: avoid; }
  .panel .sub { color: var(--faint); font-size: 7.5pt; margin: -2mm 0 3mm; }
  .cad { display: grid; grid-template-columns: 32mm 1fr 14mm; gap: 3mm; align-items: end; margin-bottom: 3mm; font-size: 8.5pt; }
  .cad .bv { text-align: right; font-family: 'JetBrains Mono', monospace; color: var(--muted); }
  .axis { display: flex; justify-content: space-between; color: var(--faint); font-size: 7pt; margin-left: 35mm; margin-right: 17mm; }

  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 4.5mm; }
  .card { border: 1px solid var(--line); border-radius: 3mm; overflow: hidden; break-inside: avoid; display: flex; flex-direction: column; }
  .shot { background: var(--panel); height: 72mm; overflow: hidden; display: flex; justify-content: center; border-bottom: 1px solid var(--line); }
  .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .noshot { height: 72mm; display: grid; place-items: center; color: var(--faint); background: var(--panel); }
  .cbody { padding: 3.5mm 4mm 4mm; display: flex; flex-direction: column; gap: 1.8mm; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 2mm; }
  .rank { font: 600 8pt 'JetBrains Mono', monospace; color: var(--faint); }
  .badge { font-size: 7.5pt; font-weight: 700; padding: .6mm 2.4mm; border-radius: 5mm; white-space: nowrap; }
  .badge.winner { color: var(--win); background: var(--win-bg); }
  .badge.promising { color: var(--prom); background: var(--prom-bg); }
  .badge.testing { color: var(--test); background: var(--test-bg); }
  .score { font: 600 14pt 'JetBrains Mono', monospace; }
  .score small { font-size: 7.5pt; color: var(--faint); }
  .who { font-weight: 600; font-size: 9pt; }
  .copy { color: #3B3B4F; font-size: 8.5pt; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .chips { display: flex; flex-wrap: wrap; gap: 1.5mm; }
  .chip { font-size: 7.5pt; color: var(--muted); border: 1px solid var(--line); padding: .3mm 2mm; border-radius: 5mm; }
  .steal { font-size: 8pt; background: color-mix(in srgb, var(--primary) 6%, #fff); border-radius: 2mm; padding: 2mm 2.5mm; }
  .steal b { color: var(--primary); }
  a { color: var(--primary); text-decoration: none; }
  .link { font-size: 7.5pt; }

  .kind { font-size: 7.5pt; font-weight: 700; padding: .4mm 2mm; border-radius: 5mm; }
  .kind.new { color: var(--prom); background: var(--prom-bg); }
  .kind.stopped { color: #B91C1C; background: #FEE2E2; }
  .kind.scaled { color: var(--test); background: var(--test-bg); }

  .opps { display: grid; gap: 4mm; counter-reset: opp; }
  .opp { border: 1px solid var(--line); border-radius: 3mm; padding: 4.5mm 5mm; display: grid; grid-template-columns: 9mm 1fr; gap: 3mm; break-inside: avoid; }
  .opp::before { counter-increment: opp; content: counter(opp); width: 8mm; height: 8mm; border-radius: 50%; display: grid; place-items: center;
    background: var(--primary); color: #fff; font: 700 9pt 'JetBrains Mono', monospace; }
  .opp h3 { margin: 0 0 1.5mm; font-size: 11pt; }
  .opp p { margin: 0 0 2mm; color: #33334A; }
  .opp .action { background: var(--panel); border-radius: 2mm; padding: 2.5mm 3mm; margin-bottom: 2mm; }
  .opp .action b { color: var(--ink); }
  .opp .ev { font-size: 7.5pt; color: var(--faint); }
  .evthumbs { display: flex; gap: 2mm; margin-top: 2mm; }
  .evthumbs img { width: 18mm; height: 18mm; object-fit: cover; object-position: top; border-radius: 1.5mm; border: 1px solid var(--line); }
  .muted { color: var(--muted); }
  .empty { padding: 7mm; text-align: center; color: var(--muted); border: 1px dashed var(--line); border-radius: 3mm; }
  .disclaimer { margin-top: 8mm; font-size: 7.5pt; color: var(--faint); }

  @media screen {
    body { background: #E7E7EE; padding: 24px 0 48px; }
    .cover, .sheet { margin: 0 auto 24px; box-shadow: 0 8px 32px rgba(10,10,30,.16); }
    .cover { border-radius: 6px; }
    .sheet { width: 210mm; background: #fff; padding: 16mm 14mm; border-radius: 6px; }
    .section { break-before: auto; }
    .section + .section { margin-top: 12mm; padding-top: 10mm; border-top: 1px solid var(--line); }
  }
  @media screen and (max-width: 820px) {
    .cover, .sheet { width: auto; margin: 0 12px 16px; }
    .cover { height: auto; min-height: 140mm; padding: 28px 22px; }
    .cover h1 { font-size: 28pt; }
    .kpis, .grid2, .grid3, .cards { grid-template-columns: 1fr 1fr; }
  }
</style>
</head>
<body class="{{ '' if 'cover' in sections else 'no-cover' }}">

{% if "cover" in sections %}
<div class="cover">
  <div class="top">
    {% if brand.logo %}<img src="{{ brand.logo }}" alt="{{ brand.agency_name }} logo">{% endif %}
    <span class="agency">{{ brand.agency_name }}</span>
  </div>
  <div class="mid">
    <div class="eyebrow">Competitor ad intelligence report</div>
    <h1>{{ title }}</h1>
    {% if client_name %}<div class="for">Prepared for <b>{{ client_name }}</b></div>{% endif %}
    <div class="rule"></div>
    <div class="brands">
      {% for b in brands %}
      <div class="chip">
        {% if b.logo_uri %}<img src="{{ b.logo_uri }}" alt="">{% else %}<span class="ph">{{ b.name[:1] }}</span>{% endif %}
        <div><b>{{ b.name }}</b><small>{{ b.stats.ads | thousands }} ads · {{ b.stats.winners }} winners</small></div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="bottom">
    <div>{{ generated_at }}<br>Prepared by {{ brand.agency_name }}</div>
    <div style="text-align:right">Source: public Meta Ad Library{% if collected_from %}<br>Ads collected {{ collected_from }}{% if collected_to != collected_from %} – {{ collected_to }}{% endif %}{% endif %}</div>
  </div>
</div>
{% endif %}

<div class="sheet">

{% if "summary" in sections %}
<section class="section">
  <div class="eyebrow">Executive summary</div>
  <h2>What the competition is running</h2>
  <p class="lede">{% if scan %}Scan #{{ scan.id }} · {{ 'Page ID' if scan.search_type == 'page_id' else 'Keyword' }} “{{ scan.query }}” · {{ scan.country }}{% else %}{{ brands | map(attribute='name') | join(', ') }}{% endif %} · {{ kpis.total | thousands }} ads analyzed{% if kpis.excluded %}. {{ kpis.excluded | thousands }} ads from other advertisers that mention these brands are excluded{% endif %}</p>
  <div class="kpis">
    <div class="kpi"><div class="n">{{ kpis.total | thousands }}</div><div class="l">Ads analyzed</div></div>
    <div class="kpi hl"><div class="n">{{ kpis.winners }}</div><div class="l">Winners ({{ kpis.winner_rate }}%)</div></div>
    <div class="kpi"><div class="n">{{ kpis.median_days }}</div><div class="l">Median days running</div></div>
    <div class="kpi"><div class="n">{{ kpis.launched_30d }}</div><div class="l">Launched in last 30 days</div></div>
  </div>
  {% if ai_summary %}
  <div class="ai-note"><span class="ai-tag">AI summary</span><div>{{ ai_summary }}</div></div>
  {% endif %}
  {% if summary_points %}
  <h3>Key findings</h3>
  <ul class="points">{% for p in summary_points %}<li>{{ p }}</li>{% endfor %}</ul>
  {% else %}
  <div class="empty">No ads have been collected for this scope yet.</div>
  {% endif %}

  {% if multi %}
  <h3 style="margin-top:7mm">Side by side</h3>
  <table>
    <thead><tr><th>Brand</th><th class="r">Ads</th><th class="r">Active</th><th class="r">Winners</th><th class="r">Winner rate</th><th class="r">Median days</th><th class="r">Longest</th><th class="r">New (30d)</th></tr></thead>
    <tbody>
    {% for b in brands %}
      <tr>
        <td><span class="brandcell">{% if b.logo_uri %}<img src="{{ b.logo_uri }}" alt="">{% else %}<span class="ph">{{ b.name[:1] }}</span>{% endif %}{{ b.name }}</span></td>
        <td class="r num">{{ b.stats.ads }}</td><td class="r num">{{ b.stats.active }}</td><td class="r num">{{ b.stats.winners }}</td>
        <td class="r num">{{ b.stats.winner_rate }}%</td><td class="r num">{{ b.stats.median_days }}</td><td class="r num">{{ b.stats.max_days }}</td><td class="r num">{{ b.stats.launched_30d }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
{% endif %}

{% if "winners" in sections %}
<section class="section">
  <div class="eyebrow">Top {{ winners | length }} by Winner Score</div>
  <h2>The ads that are working</h2>
  <p class="lede">Ranked by Winner Score: how long an ad has run, how many variations it has, where it is placed and whether it is still live.</p>
  {% if winners %}
  <div class="cards">
    {% for w in winners %}{% set ad = w.ad %}
    <article class="card">
      {% if w.image %}<div class="shot"><img src="{{ w.image }}" alt="Ad {{ ad.library_id }}"></div>{% else %}<div class="noshot">No screenshot</div>{% endif %}
      <div class="cbody">
        <div class="row">
          <span class="row" style="gap:2mm"><span class="rank">#{{ loop.index }}</span><span class="badge {{ w.badge_key }}">{{ w.badge.emoji }} {{ w.badge.label }}</span></span>
          <span class="score num">{{ ad.score }}<small>/100</small></span>
        </div>
        <div class="who">{{ ad.page_name or w.brand }}</div>
        {% if ad.headline %}<div><b>{{ ad.headline }}</b></div>{% endif %}
        {% if ad.ad_copy %}<div class="copy">{{ ad.ad_copy }}</div>{% endif %}
        <div class="chips">
          <span class="chip">{{ ad.days_running }} days</span>
          <span class="chip">{{ ad.media_type }}</span>
          {% if ad.variation_count > 1 %}<span class="chip">{{ ad.variation_count }} variations</span>{% endif %}
          {% if ad.cta_text %}<span class="chip">{{ ad.cta_text }}</span>{% endif %}
          {% if ad.status != 'active' %}<span class="chip">stopped</span>{% endif %}
        </div>
        {% if w.analysis and w.analysis.what_to_steal %}<div class="steal"><b>Steal this:</b> {{ w.analysis.what_to_steal }}</div>{% endif %}
        <a class="link" href="{{ w.library_url }}">Library ID {{ ad.library_id }} ↗</a>
      </div>
    </article>
    {% endfor %}
  </div>
  {% else %}<div class="empty">No ads in this scope.</div>{% endif %}
</section>
{% endif %}

{% if "charts" in sections and kpis.total %}
<section class="section">
  <div class="eyebrow">Creative mix</div>
  <h2>Formats, placements and angles</h2>
  <p class="lede">Share of ads using each format and placement. Winners are compared with all ads to show which choices survive.</p>
  <div class="grid2">
    <div class="panel"><h3>Format: all ads</h3><div class="sub">{{ kpis.total }} ads</div>{{ bars(charts.formats_all) }}</div>
    <div class="panel"><h3>Format: winners only</h3><div class="sub">{{ kpis.winners }} ads</div>{% if charts.formats_winners %}{{ bars(charts.formats_winners) }}{% else %}<div class="muted">No Winners yet.</div>{% endif %}</div>
    <div class="panel"><h3>Placements</h3><div class="sub">Share of ads running on each placement</div>{{ bars(charts.placements) }}</div>
    <div class="panel"><h3>How long ads run</h3><div class="sub">Ads by days running</div>{{ bars(charts.longevity) }}</div>
    {% if charts.analyzed >= 5 %}
    <div class="panel"><h3>Hook types</h3><div class="sub">AI analysis of {{ charts.analyzed }} ads</div>{{ pairs(charts.hooks) }}</div>
    <div class="panel"><h3>Top angles</h3><div class="sub">AI analysis of {{ charts.analyzed }} ads</div>{{ pairs(charts.angles) }}</div>
    {% endif %}
    {% if charts.ctas %}<div class="panel"><h3>Calls to action</h3><div class="sub">Share of ads using each button</div>{{ bars(charts.ctas) }}</div>{% endif %}
  </div>

  <div class="panel" style="margin-top:5mm">
    <h3>Launch cadence</h3><div class="sub">New ads per week by start date, last 12 weeks. Each brand on its own scale; total at right</div>
    {% for b in brands %}
    <div class="cad"><span class="bl"><b>{{ b.name }}</b></span><span>{{ b.cadence_svg | safe }}</span><span class="bv">{{ b.cadence | sum(attribute='launched') }}</span></div>
    {% endfor %}
    {% if brands %}<div class="axis"><span>{{ brands[0].cadence[0].week }}</span><span>this week</span></div>{% endif %}
  </div>

  {% if multi %}
  <h3 style="margin-top:6mm">Format mix by brand</h3>
  <div class="grid3">
    {% for b in brands %}<div class="panel"><h3>{{ b.name }}</h3><div class="sub">{{ b.stats.ads }} ads</div>{{ bars(b.formats, limit=5) }}</div>{% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}

{% if "changes" in sections and changes is not none %}
<section class="section">
  <div class="eyebrow">Change log · last {{ changes.days }} days</div>
  <h2>What changed</h2>
  <p class="lede">Detected by comparing consecutive scans of each brand: new launches, ads that stopped and ads that gained variations.</p>
  {% if changes.total %}
  <table style="margin-bottom:6mm">
    <thead><tr><th>Brand</th><th class="r">New</th><th class="r">Stopped</th><th class="r">Scaled</th></tr></thead>
    <tbody>{% for r in changes.per_brand %}<tr><td><b>{{ r.name }}</b></td><td class="r num">{{ r.new }}</td><td class="r num">{{ r.stopped }}</td><td class="r num">{{ r.scaled }}</td></tr>{% endfor %}</tbody>
  </table>
  <table>
    <thead><tr><th>Date</th><th>Brand</th><th>Change</th><th>Ad</th><th class="r">Days</th></tr></thead>
    <tbody>
    {% for e in changes.events %}
      <tr>
        <td class="num">{{ e.date.strftime('%d %b') }}</td>
        <td>{{ e.brand }}</td>
        <td><span class="kind {{ e.kind }}">{{ e.kind }}</span>{% if e.kind == 'scaled' %} <span class="muted num">{{ e.details.get('from') }}→{{ e.details.get('to') }}</span>{% endif %}</td>
        <td>{{ (e.ad.headline or e.ad.ad_copy or 'Library ID ' ~ e.ad.library_id)[:80] }}</td>
        <td class="r num">{{ e.ad.days_running }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if changes.total > changes.events | length %}<p class="muted" style="font-size:8pt">Showing the latest {{ changes.events | length }} of {{ changes.total }} changes.</p>{% endif %}
  {% else %}
  <div class="empty">No changes recorded in this period. Changes appear once a brand has been scanned at least twice, for example with a daily Watchlist schedule.</div>
  {% endif %}
</section>
{% endif %}

{% if "opportunities" in sections %}
<section class="section">
  <div class="eyebrow">{{ 'AI-generated · ' ~ ai_meta.model if opportunities_source == 'ai' else 'Derived from the data' }}</div>
  <h2>Opportunities for {{ client_name or 'you' }}</h2>
  <p class="lede">{% if opportunities_source == 'ai' %}Written by AI from the measured data and top ads in this report. Treat as hypotheses to test.{% else %}Patterns in the competitors' long-running ads worth testing, each backed by the numbers shown.{% endif %}</p>
  {% if opportunities %}
  <div class="opps">
    {% for o in opportunities %}
    <div class="opp">
      <div>
        <h3>{{ o.title }}</h3>
        <p>{{ o.detail }}</p>
        {% if o.action %}<div class="action"><b>Try:</b> {{ o.action }}</div>{% endif %}
        {% if o.evidence %}<div class="ev">Evidence: {{ o.evidence }}</div>{% endif %}
        {% if o.evidence_ads %}
        <div class="evthumbs">{% for w in o.evidence_ads %}{% if w.image %}<a href="{{ w.library_url }}"><img src="{{ w.image }}" alt="Ad {{ w.ad.library_id }}"></a>{% endif %}{% endfor %}</div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty">Not enough data yet to suggest opportunities. Scan more ads from these brands.</div>
  {% endif %}
</section>
{% endif %}

{% if "appendix" in sections %}
<section class="section">
  <div class="eyebrow">Appendix</div>
  <h2>All ads ({{ appendix_total | thousands }})</h2>
  {% if appendix_total > appendix | length %}<p class="lede">Top {{ appendix | length }} by Winner Score.</p>{% endif %}
  <table>
    <thead><tr><th class="r">Score</th><th>Brand</th><th>Headline / copy</th><th>Format</th><th class="r">Days</th><th class="r">Var.</th><th>Started</th></tr></thead>
    <tbody>
    {% for ad in appendix %}
      <tr>
        <td class="r num">{{ ad.score }}</td>
        <td>{{ ad.page_name or '—' }}</td>
        <td>{{ (ad.headline or ad.ad_copy or '—')[:80] }}</td>
        <td>{{ ad.media_type }}</td>
        <td class="r num">{{ ad.days_running }}</td>
        <td class="r num">{{ ad.variation_count }}</td>
        <td class="num">{{ ad.start_date or '—' }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>
{% endif %}

<p class="disclaimer">Source: public Meta Ad Library, collected by {{ brand.agency_name }}. Winner Score is a heuristic based on longevity, variations, placements and status. It is not spend or performance data.</p>
</div>
</body>
</html>
